# SecureGate AI Environment Configuration Template
# (Do not store real production secrets in this file)

PORT=3000
NODE_ENV=development

# Google Cloud Platform Configuration
GCP_PROJECT_ID=securegate-cloud
AR_REGION=us-central1
AR_RELEASE_REPO=release-images
AR_QUARANTINE_REPO=quarantine-staging
CLOUD_RUN_REGION=us-central1

# Database Configuration (for Spring Boot backend / MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/securegate_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=securegate_user
SPRING_DATASOURCE_PASSWORD=securegate_secret_pass

# JWT & Security
JWT_SECRET=replace_with_a_secure_256_bit_secret_key_in_production
TRIVY_BIN_PATH=trivy
